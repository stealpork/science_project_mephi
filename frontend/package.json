{
  "name": "science-interaction-web",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage && node tools/check-coverage.mjs",
    "test:e2e": "node --test --test-concurrency=1 tests/react.e2e.mjs",
    "test:live": "node tools/live-e2e.mjs",
    "test:demo": "node tools/demo-check.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "5.108.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "26.0.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.2",
    "jsdom": "31.0.1",
    "puppeteer-core": "25.19.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.2"
  }
}
